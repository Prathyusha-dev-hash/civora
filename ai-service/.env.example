# Civora AI Service
PORT=8000
HOST=127.0.0.1

# Google Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if GEMINI_MODEL is not available for your key
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=40

# Shared secret; must equal AI_SERVICE_TOKEN in backend/.env
AI_SERVICE_TOKEN=

MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
