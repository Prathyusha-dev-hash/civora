# Civora Frontend Environment Configuration
# Copy to .env.local to customise.

# API base path. Keep the default '/api/v1' in development: Vite proxies /api to VITE_BACKEND_ORIGIN.
# On Vercel set the full backend URL, e.g. https://civora-backend.vercel.app/api/v1
VITE_API_BASE_URL=/api/v1

# Backend origin used by the Vite dev proxy
VITE_BACKEND_ORIGIN=http://localhost:5000
