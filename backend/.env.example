# ---------------- Civora Backend ----------------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). REQUIRED.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/civora?retryWrites=true&w=majority
MONGODB_URI=

# Long random string (min 16 chars). REQUIRED.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allowed browser origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# ---- File storage (local disk now; provider interface supports object storage later)
# 'local' (disk, default) or 'gridfs' (files stored in MongoDB; required on Vercel, whose disk is not persistent)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
# Secret for signed file URLs (defaults to JWT_SECRET)
FILE_URL_SIGNING_SECRET=
FILE_URL_TTL_SECONDS=21600
# Prefix for signed file URLs; leave empty when the frontend proxies /api (default dev setup)
PUBLIC_API_BASE_URL=
MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
MAX_IMAGES_PER_COMPLAINT=5

# ---- AI service (ai-service/)
AI_SERVICE_URL=http://127.0.0.1:8000
# Must equal AI_SERVICE_TOKEN in ai-service/.env
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=45000

# ---- Duplicate detection
DUP_RADIUS_METERS=250
DUP_WINDOW_DAYS=30
DUP_THRESHOLD=0.72
DUP_SEMANTIC_MIN=0.70

# ---- SLA hours per severity
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=12
SLA_MODERATE_HOURS=48
SLA_LOW_HOURS=96

# ---- Vercel Cron: random secret; Vercel sends it as a bearer token to /api/v1/internal/maintenance
CRON_SECRET=

# ---- Initial accounts (seeded once on first start; never overwritten)
# Staff accounts (admin + department supervisors/officers) use this password.
SEED_STAFF_PASSWORD=
# Optional demo citizen citizen@civora.org (leave empty to skip)
SEED_DEMO_CITIZEN_PASSWORD=
